<%
// One template for every list of notes.
// The markup is emitted inside a single raw HTML block: listing templates are parsed as
// Markdown, and indented HTML would otherwise turn into code blocks.
//   template-params.mode = "grouped" : one section per post type (Notes page)
//   template-params.mode = "flat"    : a single list with a type label per row (Home)
// Post types are the human-readable `post-type` values in each note's front matter.
const kinds = [
  { name: "Fundamentals", blurb: "Connected study notes on the ideas that foundational papers share." },
  { name: "Paper Review", blurb: "What a recent paper proposes, and what its results do and do not show." },
  { name: "Experiment", blurb: "Reproductions and checks, including the ones that did not work." }
];
const mode = (templateParams && templateParams.mode) || "grouped";
const slug = (s) => String(s || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const known = kinds.map(k => k.name);

const row = (item, showKind) => { %>
  <li class="note-row" <%= metadataAttrs(item) %>>
    <% if (showKind && item["post-type"]) { %>
    <div class="note-kicker"><span class="type-label" data-type="<%- item["post-type"] %>"><%- item["post-type"] %></span></div>
    <% } %>
    <h3 class="no-anchor listing-title"><a href="<%- item.path %>" class="no-external"><%- item.title %></a></h3>
    <% if (item.subtitle) { %><p class="note-subtitle listing-subtitle"><%- item.subtitle %></p><% } %>
    <% if (item.description) { %><p class="note-desc listing-description"><%- item.description %></p><% } %>
    <p class="note-meta">
      <% if (item.date) { %><span class="listing-date"><%- item.date %></span><% } %>
      <% if (item["reading-time"]) { %><span class="sep" aria-hidden="true">·</span><span class="listing-reading-time"><%- item["reading-time"] %></span><% } %>
      <% if (item.categories && item.categories.length) { %>
      <span class="note-topics"><% for (const c of item.categories) { %><span class="topic"><%- c %></span><% } %></span>
      <% } %>
    </p>
  </li>
<% };
%>

```{=html}
<% if (mode === "flat") { %>
<ul class="note-list list">
<% for (const item of items) { row(item, true); } %>
</ul>
<% } else if (mode === "kinds") { %>
<div class="kind-grid">
<% for (const kind of kinds) {
     const n = items.filter(i => i["post-type"] === kind.name).length;
     if (n === 0) continue; %>
  <div class="kind-card">
    <a class="type-label" data-type="<%- kind.name %>" href="notes.html#<%- slug(kind.name) %>"><%- kind.name %></a>
    <p><%- kind.blurb %></p>
  </div>
<% } %>
</div>
<% } else { %>
<% for (const kind of kinds) {
     const group = items.filter(i => i["post-type"] === kind.name);
     if (group.length === 0) continue; %>
<section class="note-group" id="<%- slug(kind.name) %>">
  <div class="note-group-head">
    <h2 class="no-anchor"><span class="type-label" data-type="<%- kind.name %>"><%- kind.name %></span></h2>
    <p class="note-group-blurb"><%- kind.blurb %></p>
  </div>
  <ul class="note-list">
  <% for (const item of group) { row(item, false); } %>
  </ul>
</section>
<% } %>
<% const rest = items.filter(i => !known.includes(i["post-type"]));
   if (rest.length > 0) { %>
<section class="note-group" id="other">
  <div class="note-group-head">
    <h2 class="no-anchor"><span class="type-label">Other</span></h2>
  </div>
  <ul class="note-list">
  <% for (const item of rest) { row(item, true); } %>
  </ul>
</section>
<% } %>
<% } %>
```
